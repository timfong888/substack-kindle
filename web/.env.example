# Copy to .env.local and fill in. Never commit real values.
# Clerk (Dashboard -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Convex (written by `npx convex dev`; production URL from the Convex dashboard)
NEXT_PUBLIC_CONVEX_URL=
# Clerk Frontend API URL (Dashboard -> API keys -> Frontend API URL).
# Also set on the Convex deployment: npx convex env set CLERK_JWT_ISSUER_DOMAIN <value>
CLERK_JWT_ISSUER_DOMAIN=
