# Copy to .env.local and fill in. Never commit real values.
# Clerk (Dashboard -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Convex (written by `npx convex dev`; production URL from the Convex dashboard)
NEXT_PUBLIC_CONVEX_URL=
# Clerk Frontend API URL (Dashboard -> API keys -> Frontend API URL).
# Also set on the Convex deployment: npx convex env set CLERK_JWT_ISSUER_DOMAIN <value>
CLERK_JWT_ISSUER_DOMAIN=
# Convex deployment env (set with `npx convex env set`, not in .env.local):
#   KINDLE_SENDER_DOMAIN    Resend-verified domain for per-user senders, e.g. mail.fong888.com
#   PIPELINE_SHARED_SECRET  shared with the digest runner (32+ random chars)
#   RESEND_API_KEY          sends the Kindle test document
